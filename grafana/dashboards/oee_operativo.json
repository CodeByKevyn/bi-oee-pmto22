{
  "uid": "bi-oee-operativo",
  "title": "Monitoreo operativo de las líneas de envasado",
  "description": "Lecturas hora a hora de Vinilos_1 a Vinilos_4 (rt.lectura_hora). Se llena con etl/simulador_hora.py.",
  "tags": [
    "oee",
    "envasado"
  ],
  "timezone": "America/Bogota",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-24h",
    "to": "now+12h"
  },
