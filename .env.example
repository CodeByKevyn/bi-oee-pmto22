# copiar a .env y completar los valores (el .env no se sube al repositorio)

# base de datos (para el ETL, DBeaver y docker compose)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=
PGDATABASE=bi_oee

# ruta del libro de Excel (no se versiona)
XLSM_PATH=data/raw/SEGUIMIENTO TEMPERAS Y VINILOS Actividad.xlsm

# sal para generar los alias de las personas
PSEUDO_SALT=

# usuario de solo lectura que usa Grafana y administrador de Grafana (docker compose)
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
